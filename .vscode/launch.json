{
  "version": "0.2.0",
  // Requires the Bun VS Code extension: oven-sh.bun-vscode
  // NOTE: Always run via Bun, NOT Node. Node fails on native modules (color-diff-napi, etc.)
  // that are resolved at runtime by Bun's module system.
  "configurations": [
    // ─────────────────────────────────────────────────────────────
    // PRIMARY DEBUG CONFIGS (target the compiled dist/main.js)
    //
    // These use source maps (dist/main.js.map) to map breakpoints
    // back to the original src/ TypeScript files.
    // ─────────────────────────────────────────────────────────────
    {
      // Runs the TypeScript SOURCE directly — no bundle, no external sourcemap.
      // The Bun VS Code extension natively maps breakpoints in .tsx files because
      // Bun transpiles the source internally and its debugger knows the mapping.
      // --preload injects the MACRO global that build.ts normally inlines at build time.
      "name": "CLI-Interactive",
      "type": "bun",
      "request": "launch",
      "program": "${workspaceFolder}/src/entrypoints/cli.tsx",
      "cwd": "${workspaceFolder}",
      "env": {
        "ANTHROPIC_API_KEY": "${env:ANTHROPIC_API_KEY}"
      },
      "args": [
        "--dump-system-prompt"
      ],
      "runtimeArgs": [
        "--preload",
        "./debug/preload-macros.ts"
      ],
      "stopOnEntry": false
    },
    {
      // Print mode — non-interactive, easier to debug a single prompt without Ink UI
      "name": "CLI-Print",
      "type": "bun",
      "request": "launch",
      "program": "${workspaceFolder}/src/entrypoints/cli.tsx",
      "cwd": "${workspaceFolder}",
      "env": {
        "ANTHROPIC_API_KEY": "${env:ANTHROPIC_API_KEY}",
        "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "true"
      },
      "args": [
        "-p",
        "list the tools you have available, focusing on team/agent tools"
      ],
      "runtimeArgs": [
        "--preload",
        "./debug/preload-macros.ts"
      ],
      "stopOnEntry": false
    },
    {
      // Same as print mode but pauses immediately on entry — set your breakpoints before resuming
      "name": "CLI-Print-Entry",
      "type": "bun",
      "request": "launch",
      "program": "${workspaceFolder}/src/entrypoints/cli.tsx",
      "cwd": "${workspaceFolder}",
      "env": {
        "ANTHROPIC_API_KEY": "${env:ANTHROPIC_API_KEY}",
        "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "true"
      },
      "args": [
        "-p",
        "hello"
      ],
      "runtimeArgs": [
        "--preload",
        "./debug/preload-macros.ts"
      ],
      "stopOnEntry": true
    },
    {
      // Run the build script itself under the debugger
      "name": "🔨 Debug build.ts",
      "type": "bun",
      "request": "launch",
      "program": "${workspaceFolder}/build.ts",
      "cwd": "${workspaceFolder}",
      "env": {},
      "stopOnEntry": false
    },
    // ─────────────────────────────────────────────────────────────
    // SOURCE-LEVEL DEBUG CONFIGS (run src/*.tsx directly via preload)
    //
    // debug/preload.ts shims the 'bun:bundle' virtual module so that
    // import { feature } from 'bun:bundle' works when running source
    // files directly (without bundling). Without this shim, Bun throws
    // "Cannot find module 'bun:bundle'" immediately on startup.
    //
    // Trade-off: breakpoints are in original .tsx files (better DX),
    // but MACRO.* constants are NOT defined — any code touching
    // MACRO.PACKAGE_URL etc. will throw ReferenceError at runtime.
    // Use these configs for exploring subsystems that don't hit MACRO.
    // ─────────────────────────────────────────────────────────────
    {
      // Run src/main.tsx directly — skips the build step entirely.
      // Good for exploring startup flow + tool registration.
      "name": "📄 Source: Full CLI (via preload)",
      "type": "bun",
      "request": "launch",
      "program": "${workspaceFolder}/src/main.tsx",
      "cwd": "${workspaceFolder}",
      "env": {
        "ANTHROPIC_API_KEY": "${env:ANTHROPIC_API_KEY}",
        "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "true"
      },
      "args": [
        "-p",
        "hello"
      ],
      "runtimeArgs": [
        "--preload",
        "${workspaceFolder}/debug/preload.ts"
      ],
      "stopOnEntry": false
    },
    {
      "name": "Auth",
      "type": "bun",
      "request": "launch",
      "program": "${workspaceFolder}/debug/explore-auth.ts",
      "cwd": "${workspaceFolder}",
      "env": {
        "ANTHROPIC_API_KEY": "${env:ANTHROPIC_API_KEY}"
      },
      "runtimeArgs": [
        "--preload",
        "${workspaceFolder}/debug/preload.ts"
      ]
    },
    {
      "name": "Skills",
      "type": "bun",
      "request": "launch",
      "program": "${workspaceFolder}/debug/explore-skills.ts",
      "cwd": "${workspaceFolder}",
      "env": {
        "ANTHROPIC_API_KEY": "${env:ANTHROPIC_API_KEY}"
      },
      "runtimeArgs": [
        "--preload",
        "${workspaceFolder}/debug/preload.ts"
      ],
      "stopOnEntry": true
    },
    {
      "name": "QueryEngine (prompt → LLM loop)",
      "type": "bun",
      "request": "launch",
      "program": "${workspaceFolder}/debug/explore-query.ts",
      "cwd": "${workspaceFolder}",
      "env": {
        "ANTHROPIC_API_KEY": "${env:ANTHROPIC_API_KEY}"
      },
      "runtimeArgs": [
        "--preload",
        "${workspaceFolder}/debug/preload.ts"
      ],
      "stopOnEntry": true
    },
    {
      "name": "AgentTool (sub-agents)",
      "type": "bun",
      "request": "launch",
      "program": "${workspaceFolder}/debug/explore-agents.ts",
      "cwd": "${workspaceFolder}",
      "env": {
        "ANTHROPIC_API_KEY": "${env:ANTHROPIC_API_KEY}"
      },
      "runtimeArgs": [
        "--preload",
        "${workspaceFolder}/debug/preload.ts"
      ],
      "stopOnEntry": true
    },
    {
      "name": "Permissions",
      "type": "bun",
      "request": "launch",
      "program": "${workspaceFolder}/debug/explore-permissions.ts",
      "cwd": "${workspaceFolder}",
      "env": {
        "ANTHROPIC_API_KEY": "${env:ANTHROPIC_API_KEY}"
      },
      "runtimeArgs": [
        "--preload",
        "${workspaceFolder}/debug/preload.ts"
      ],
      "stopOnEntry": true
    },
    // ─────────────────────────────────────────────────────────────
    // ATTACH — connect to an already-running Bun process
    // Start the process first with:
    //   bun --inspect dist/main.js
    // or (source-level):
    //   bun --inspect --preload debug/preload.ts src/main.tsx -p hello
    // ─────────────────────────────────────────────────────────────
    {
      "name": "🔗 Attach to running Bun process",
      "type": "bun",
      "request": "attach",
      "port": 6499,
      "hostname": "localhost"
    }
  ]
}